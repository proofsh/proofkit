{
  "$schema": "https://v2-8-19.turborepo.dev/schema.json",
  "concurrency": "11",
  "globalEnv": ["FLAGS", "FLAGS_SECRET", "ENABLE_EXPERIMENTAL_COREPACK"],
  "ui": "tui",
  "tasks": {
    "build": {
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
      "dependsOn": ["^build"]
    },
    "@proofkit/docs#build": {
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**",
        "public/registry-templates/**"
      ],
      "dependsOn": ["^build"]
    },
    "test": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "vitest.config.*",
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.spec.ts",
        "**/*.spec.tsx"
      ],
      "outputs": [],
      "dependsOn": ["^build"]
    },
    "@proofkit/fmodata#test": {
      "dependsOn": ["@proofkit/fmodata#build", "^build"]
    },
    "test:e2e": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "vitest.config.*",
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.spec.ts",
        "**/*.spec.tsx"
      ],
      "outputs": [],
      "dependsOn": ["^build"],
      "cache": false
    },
    "test:watch": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "lint": {},
    "dev": {
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    }
  }
}
