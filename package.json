{
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "build": "turbo run build --filter={./packages/*} --filter=@proofkit/docs",
    "ci": "pnpm ci:pr",
    "ci:build": "pnpm build",
    "ci:cli-smoke": "pnpm --filter @proofkit/cli build && pnpm exec varlock run -- pnpm --filter @proofkit/cli test:smoke",
    "ci:fmodata-e2e": "pnpm --filter @proofkit/fmodata test:e2e",
    "ci:lint": "pnpm lint && pnpm skill:check-versions",
    "ci:pr": "pnpm ci:lint && pnpm ci:typecheck && pnpm ci:test && pnpm ci:build",
    "ci:release": "pnpm ci:lint && pnpm ci:typecheck && pnpm ci:test && pnpm ci:cli-smoke && pnpm ci:fmodata-e2e",
    "ci:test": "pnpm test",
    "ci:typecheck": "pnpm typecheck",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "skill:check-versions": "node scripts/check-skill-versions.mjs",
    "skill:sync-versions": "node scripts/sync-skill-versions.mjs",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "biome format --write .",
    "changeset": "changeset",
    "version-packages": "pnpm skill:sync-versions && changeset version && pnpm skill:sync-versions",
    "sherif": "pnpm dlx sherif@latest",
    "sherif:fix": "pnpm sherif --fix",
    "release": "turbo run build --filter={./packages/*} && changeset publish",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "knip": "knip",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.11",
    "@changesets/cli": "^2.29.8",
    "@types/node": "^22.19.5",
    "@varlock/1password-plugin": "^0.3.0",
    "husky": "^9.1.7",
    "knip": "^5.80.2",
    "lint-staged": "^16.2.7",
    "textlint": "^15.5.2",
    "turbo": "^2.8.19",
    "typescript": "^5.9.3",
    "ultracite": "7.0.8",
    "varlock": "^0.6.4",
    "vitest": "^4.0.17"
  },
  "packageManager": "pnpm@11.0.0",
  "engines": {
    "node": ">=18"
  },
  "name": "with-changesets",
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,jsonc,css,scss,md,mdx}": [
      "pnpm dlx ultracite fix"
    ]
  }
}
